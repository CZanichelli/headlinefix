# Copy to .env.local and fill in (Supabase > Project Settings > API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...) works as the anon key
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Ordana widget (server-side only; see ORDANA_WIDGET.md). Leave empty until Ordana gives them.
ORDANA_WIDGET_KEY=
ORDANA_API_URL=
ORDANA_OIDC_ISSUER=
ORDANA_OIDC_CLIENT_ID=
ORDANA_OIDC_CLIENT_SECRET=
ORDANA_WIDGET_SESSION_SECRET=
