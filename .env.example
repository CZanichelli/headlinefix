# Copy to .env.local and fill in (Supabase > Project Settings > API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...) works as the anon key
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Ordana widget (server-side only; see ORDANA_WIDGET.md). wsk_test_… locally, wsk_live_… in production.
# The only Ordana variable: the OIDC client id/issuer and the session secret come from Ordana's whoami.
# Optional overrides: ORDANA_API_URL, ORDANA_OIDC_CLIENT_SECRET
ORDANA_WIDGET_KEY=
# Server only, never VITE_: lets "Open HeadlineFix" in the widget sign people straight in.
# A Supabase secret key (sb_secret_…, Project Settings > API Keys > Secret keys).
SUPABASE_SERVICE_ROLE_KEY=
